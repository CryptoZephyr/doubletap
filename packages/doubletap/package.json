{
  "name": "appwrite-doubletap",
  "version": "0.2.1",
  "description": "Exactly-once claims and worker leases for Appwrite TablesDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CryptoZephyr/doubletap.git"
  },
  "homepage": "https://doubletap-lab.appwrite.network",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "bin": {
    "doubletap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('fs').cpSync('../../skills','skills',{recursive:true})\""
  },
  "peerDependencies": {
    "node-appwrite": "^31.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "node-appwrite": "^31.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
